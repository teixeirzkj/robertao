# Postgres (Vercel Postgres, Neon, Supabase, Railway...)
# Use a connection string "pooled" quando o provedor oferecer.
DATABASE_URL="postgres://usuario:senha@host:5432/banco?sslmode=require"

# Senha de acesso ao painel /admin
ADMIN_PASSWORD="troque-esta-senha"

# Opcional: segredo usado para assinar o cookie de sessao do admin.
# Se nao for definido, o ADMIN_PASSWORD e usado como segredo.
ADMIN_SESSION_SECRET=""

# Segredo do webhook de confirmacao de pagamento (InfinitePay via n8n).
# Sem ele, POST /api/webhooks/pagamento responde 503 e nada e confirmado.
# O n8n envia esse valor no header `x-webhook-secret`.
WEBHOOK_SECRET=""
